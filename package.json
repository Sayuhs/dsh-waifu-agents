{
  "name": "dsh-waifu-agents",
  "version": "0.3.0",
  "type": "module",
  "description": "Registers every *.md in a persona directory as an agent preset, and manages them from the Plugins settings page.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "persona",
    "agent-preset"
  ],
  "scripts": {
    "test": "node scripts/run-suites.mjs",
    "eval": "node scripts/run-suites.mjs eval",
    "doctor": "node scripts/doctor.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "team.js",
    "zip.js",
    "text.js",
    "package-meta.js",
    "self-update.js",
    "commands.js",
    "http-route.js",
    "panel-ops.js",
    "memory-ops.js",
    "team-mode.js",
    "team-simulate.js",
    "team-snapshot.js",
    "team-runtime.js",
    "team-memory.js",
    "persona-memory.js",
    "tool-filter.js",
    "seed-assets.js",
    "cordis.patch.yml",
    "template.json",
    "personas/",
    "locale/",
    "scripts/",
    "icon.png",
    "docs/token-cost-ladder.svg",
    "docs/token-cache-lines.svg",
    "README.md"
  ],
  "icon": "./icon.png",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
