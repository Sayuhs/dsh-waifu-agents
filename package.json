{
  "name": "dsh-waifu-agents",
  "version": "0.2.5",
  "type": "module",
  "description": "Registers every *.md in a persona directory as an agent preset, and manages them from the Plugins settings page.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "persona",
    "agent-preset"
  ],
  "scripts": {
    "test": "node selftest-v3.mjs && node selftest-dual.mjs && node selftest-r5.mjs",
    "eval": "node eval-v3.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "team.js",
    "zip.js",
    "team-simulate.js",
    "team-snapshot.js",
    "team-runtime.js",
    "team-memory.js",
    "cordis.patch.yml",
    "template.json",
    "personas/",
    "locale/",
    "icon.png",
    "docs/",
    "README.md"
  ],
  "icon": "./icon.png",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
